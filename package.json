{
  "name": "paseo-pagey",
  "version": "1.0.0",
  "private": true,
  "description": "Publish static sites to Pagey's free hosting from Paseo, with upload previews and updates at the same URL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/freakynit/paseo-pagey.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@getpaseo/client": "0.14.0-beta.1",
    "@getpaseo/plugin": "0.14.0-beta.1",
    "@getpaseo/protocol": "0.14.0-beta.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
